{
    "name": "musautop",
    "domain": "musautop.com",
    "rootPath": "/home/superga/tesite/var/docker/musautop",
    "sitePath": "/home/superga/tesite/var/www/musautop",
    "nginxPath": "/home/superga/tesite/var/docker/server/nginx.conf.d",
    "repository": "https://github.com/musautop/musautop.git",
    "docker":{
        "version": "3",
        "networks":{
            "queed": {
                "external": true
            }
        },
        "services": [
            {
                "tag":"musautop",
                "image": "node:22-alpine",
                "restart": "always",
                "ports": ["3800:3000"],
                "working_dir": "/app",
                "environment": [
                    "NODE_ENV=production",
                    "NODE_PRESERVE_SYMLINKS=true"

                ],
                "volumes": [
                    "/var/www/musautop/:/app"
                ],
                "networks": ["queed"]
            }
        ]
    },
    "nginx": {
        "root": "http://musautop.com:3800",
        "ssl": false,
        "server_script": "docker restart server-webserver-1"
    }
}